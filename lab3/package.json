{
  "name": "campushub-lab3",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHub Lab 3: three-tier Express API with Mongoose boundary enforcement.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "lint:api": "redocly lint docs/openapi.yaml"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "mongoose": "^8.15.1"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
