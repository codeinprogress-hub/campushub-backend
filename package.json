{
  "name": "campushub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHub reservation engine for CS 5500: OpenAPI contract, Express API, and auto-healing CI.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit && eslint src",
    "lint:api": "redocly lint docs/openapi.yaml",
    "test": "npm run test:healer && jest --ci --colors=false",
    "test:healer": "node --test scripts/auto-heal.test.mjs",
    "auto-heal": "node scripts/auto-heal.mjs --log test-results.log"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^1.34.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0"
  }
}
